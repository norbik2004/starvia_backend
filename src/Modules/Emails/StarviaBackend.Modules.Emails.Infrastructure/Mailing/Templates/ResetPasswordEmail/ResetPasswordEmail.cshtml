@model StarviaBackend.Modules.Emails.Application.Emails.Templates.Models.ResetPasswordEmailTemplateModel

<p style="margin: 0 0 16px 0; color: #898d94; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6;">
    Cześć, <strong style="color: #29303d; font-weight: 700;">@Model.UserName</strong>
</p>

<p style="margin: 0 0 16px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.6;">
    Otrzymaliśmy prośbę o zresetowanie hasła do Twojego konta w Starvia. Kliknij poniższy przycisk, żeby ustawić nowe hasło.
</p>

<p style="margin: 0 0 24px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.6;">
    Link działa jeden raz i wkrótce wygaśnie. Jeśli nie prosiłeś o reset, zignoruj tę wiadomość — hasło pozostanie bez zmian.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 24px 0;">
    <tr>
        <td align="center" bgcolor="#2d2d2d" style="background-color: #2d2d2d; border-radius: 30px;">
            <a href="@Model.Link"
               style="display: inline-block; padding: 14px 24px; background-color: #2d2d2d; color: #ffffff; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; text-decoration: none; border-radius: 30px;">
                Ustaw nowe hasło
            </a>
        </td>
    </tr>
</table>

<p style="margin: 0; color: #898d94; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 14px; line-height: 1.5;">
    Przycisk nie działa? Skopiuj i wklej ten adres w przeglądarce:<br />
    <a href="@Model.Link" style="color: #29303d; font-weight: 600; word-break: break-all;">@Model.Link</a>
</p>
