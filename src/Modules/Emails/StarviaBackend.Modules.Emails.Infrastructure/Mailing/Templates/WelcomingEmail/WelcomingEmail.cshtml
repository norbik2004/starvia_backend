@model StarviaBackend.Modules.Emails.Application.Emails.Templates.Models.WelcomingEmailTemplateModel

<p style="margin: 0 0 16px 0; color: #898d94; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6;">
    Cześć, <strong style="color: #29303d; font-weight: 700;">@Model.UserName</strong>
</p>

<p style="margin: 0 0 16px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.6;">
    Cieszymy się, że jesteś z nami. Konto w Starvia jest gotowe — planuj, pisz i publikuj treści w jednym spokojnym miejscu.
</p>

<p style="margin: 0 0 8px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.6;">
    W workspace znajdziesz:
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin: 0 0 20px 0;">
    <tr>
        <td style="padding: 10px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5;">
            <span style="display: inline-block; width: 8px; height: 8px; margin-right: 10px; background-color: #e6fb2d; border-radius: 999px; vertical-align: middle;"></span>
            Zarządzanie draftami, wersjami i statusami
        </td>
    </tr>
    <tr>
        <td style="padding: 10px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5;">
            <span style="display: inline-block; width: 8px; height: 8px; margin-right: 10px; background-color: #e6fb2d; border-radius: 999px; vertical-align: middle;"></span>
            AI copy i obrazy w tonie Twojej marki
        </td>
    </tr>
    <tr>
        <td style="padding: 10px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.5;">
            <span style="display: inline-block; width: 8px; height: 8px; margin-right: 10px; background-color: #e6fb2d; border-radius: 999px; vertical-align: middle;"></span>
            Kalendarz publikacji na Facebooku, Instagramie i LinkedIn
        </td>
    </tr>
</table>

<p style="margin: 0 0 24px 0; color: #29303d; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 400; line-height: 1.6;">
    Wejdź do panelu i zacznij od pierwszego posta.
</p>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin: 0;">
    <tr>
        <td align="center" bgcolor="#2d2d2d" style="background-color: #2d2d2d; border-radius: 30px;">
            <a href="@Model.Link"
               style="display: inline-block; padding: 14px 24px; background-color: #2d2d2d; color: #ffffff; font-family: 'Red Hat Display', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 600; letter-spacing: -0.01em; text-decoration: none; border-radius: 30px;">
                Przejdź do panelu
            </a>
        </td>
    </tr>
</table>
